DISCORD_TOKEN_2=token_akun_discord_2
DISCORD_TOKEN_3=token_akun_discord_3
DISCORD_TOKEN_4=token_akun_discord_4

# ── Settings (opsional) ───────────────────────────
TARGET_X_USERNAME=GuarEmperor
CHECK_INTERVAL=60
